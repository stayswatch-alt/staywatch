# Copy to .env.local and fill in your values.

# Supabase — database & auth (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local migration runner only (scripts/run-migration.mjs) — never commit real values
SUPABASE_DB_PASSWORD=
# Optional: Management API token (Database Read-write) — bypasses IP restrictions
SUPABASE_ACCESS_TOKEN=

# Cloudinary — evidence screenshots (Dashboard → Settings → Upload)
# Create an UNSIGNED upload preset named e.g. staywatch_evidence
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=staywatch_evidence
